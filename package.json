{
  "name": "discord-moderation-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "register-commands": "tsx scripts/register-commands.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.3",
    "@prisma/client": "^6.1.0",
    "discord-api-types": "^0.37.115",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.4"
}
